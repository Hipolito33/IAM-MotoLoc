generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Moto {
  id               Int    @id @default(autoincrement())
  marca            String
  modelo           String
  quilometragem    Int
  placa            String @unique
  chassi           String @unique
  cor              String
  cilindrada       Int
}