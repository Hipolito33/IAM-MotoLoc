generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Moto {
  id Int @id @default(autoincrement())
  marca String
  modelo String
  quilometragem Int
  placa String @unique
  chassi String @unique
  cor String
  cilindrada Int
}
